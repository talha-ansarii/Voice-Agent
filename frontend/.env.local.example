# Leave empty so the browser talks to Next.js same-origin /api (session cookie).
NEXT_PUBLIC_API_URL=

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3001
EXPRESS_INTERNAL_URL=http://127.0.0.1:8001

# Production (Coolify): AUTH_URL=https://your.domain
# EXPRESS_INTERNAL_URL=http://127.0.0.1:8000
# Google redirect: https://your.domain/api/auth/callback/google

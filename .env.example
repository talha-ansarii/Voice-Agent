# ══════════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in values (never commit .env)
# ══════════════════════════════════════════════════════════════════════════════

# ── LiveKit Cloud (required) ──────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ── Outbound telephony (required for outbound calls) ──────────────────────────
OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxxxxxx
VOBIZ_SIP_DOMAIN=your_sip_domain.sip.vobiz.ai
VOBIZ_USERNAME=your_username
VOBIZ_PASSWORD=your_password
VOBIZ_OUTBOUND_NUMBER=+91XXXXXXXXXX

# ── Google Gemini (required — LLM + post-call sentiment) ──────────────────────
# Must be a Google AI Studio key (starts with AIzaSy), NOT a GCP project ID.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_key_here

# ── Deepgram (default STT + TTS) ──────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── Sarvam AI (optional — if stt_provider/tts_provider = sarvam in config.json)
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Neon Postgres (Prisma) ────────────────────────────────────────────────────
# Dashboard → Connect → Direct connection (host must NOT contain -pooler)
DATABASE_URL="postgresql://neondb_owner:[YOUR-PASSWORD]@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Optional: recording storage (S3-compatible — not the database) ────────────
# Set RECORDING_DISABLED=1 to skip LiveKit egress entirely.
RECORDING_DISABLED=
# Generic S3 (preferred) — works with Supabase Storage, R2, MinIO, etc.
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
RECORDING_S3_ENDPOINT=
RECORDING_S3_BUCKET=call-recordings
RECORDING_S3_REGION=ap-south-1
# Public URL base for playback links (no trailing slash)
RECORDING_PUBLIC_URL_BASE=

# Legacy Supabase Storage aliases (still supported if RECORDING_S3_* unset)
SUPABASE_URL=
SUPABASE_KEY=

# ── Supabase S3 (optional — call recordings via LiveKit egress) ───────────────
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-northeast-1

# ── Cal.com (optional) ──────────────────────────────────────────────────────
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# ── Telegram (optional) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to 1 to disable Telegram alerts (avoids 403 spam if misconfigured)
TELEGRAM_DISABLED=

DEFAULT_TRANSFER_NUMBER=
LIVEKIT_AGENT_NAME=outbound-caller

# ── Outbound rate limit (per phone number, uses call_logs in DB) ─────────────
# Set OUTBOUND_RATE_LIMIT_MAX=0 to disable. Defaults: 50 calls / 60 minutes.
OUTBOUND_RATE_LIMIT_MAX=50
OUTBOUND_RATE_LIMIT_WINDOW_MS=3600000
OUTBOUND_BULK_CONCURRENCY=10
UI_METRICS_URL=http://127.0.0.1:8001/internal/record-call

# ── Google login (Auth.js / NextAuth v5 on the dashboard) ─────────────────────
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3001
EXPRESS_INTERNAL_URL=http://127.0.0.1:8001

# ── Production (Hetzner + Coolify) — see docs/COOLIFY_DEPLOYMENT.md ───────────
# Public Next.js on :3000 only. Never publish Express :8000.
# PORT=8000
# EXPRESS_INTERNAL_URL=http://127.0.0.1:8000
# UI_METRICS_URL=http://127.0.0.1:8000/internal/record-call
# NEXT_PUBLIC_API_URL=
# AUTH_URL=https://studio.example.com
# AUTH_TRUST_HOST=true
# Google OAuth redirect: https://studio.example.com/api/auth/callback/google
# RECORDING_DISABLED=1
# TELEGRAM_DISABLED=1
